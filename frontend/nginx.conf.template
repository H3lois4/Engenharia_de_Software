# Template processado na inicialização do container (envsubst substitui ${PORT}).
# Render define PORT (padrão 10000). No docker-compose local usamos PORT=80.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: todas as rotas caem no index.html (react-router)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy opcional para o BFF — usado no docker-compose local (serviço "bff").
    # Na nuvem, o portal fala direto com a URL pública do BFF (VITE_API_BASE_URL),
    # então estes blocos não são exercitados lá.
    location /api/ {
        proxy_pass http://bff:8006;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /ws/ {
        proxy_pass http://bff:8006;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
