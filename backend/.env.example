# ===== BFF do ms-dashboard — exemplo de variáveis de ambiente =====
# Copie para .env e ajuste conforme necessário.

# Aplicação
APP_ENV=development
PORT=8006
LOG_LEVEL=INFO
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Usa mocks dos serviços downstream (demo sem os outros grupos no ar)
USE_MOCKS=true

# Autenticação — JWT emitido pelo Módulo 1
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# JWT_ISSUER=
# JWT_AUDIENCE=

# URLs dos serviços downstream (usadas quando USE_MOCKS=false)
NOTIFICATIONS_URL=http://ms-notifications:8000
CHAT_URL=http://ms-chat:8000
BACKLOG_URL=http://module-1:8000
GITHUB_URL=http://module-2:8000

# Resiliência
UPSTREAM_TIMEOUT_SECONDS=3.0
CIRCUIT_BREAKER_FAILS=5
CIRCUIT_BREAKER_RESET_SECONDS=15.0
CACHE_TTL_SECONDS=30.0

# Chat
CHAT_HISTORY_LIMIT=50
